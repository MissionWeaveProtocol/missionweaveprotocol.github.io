{
  "name": "missionweaveprotocol-website",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "docs:dev": "astro dev",
    "docs:build": "astro build && node scripts/generate-normative-release.mjs",
    "docs:preview": "astro preview",
    "assets:generate": "node scripts/generate-brand-assets.mjs",
    "assets:check": "npm run assets:generate && node scripts/check-brand-assets.mjs",
    "artifacts:sync": "node scripts/sync-normative-artifacts.mjs",
    "specification:sync": "node scripts/sync-normative-specification.mjs",
    "sources:checkout": "node scripts/checkout-normative-sources.mjs",
    "test:sources-checkout-paths": "node scripts/test-checkout-normative-sources.mjs",
    "test:normative-specification": "node scripts/test-sync-normative-specification.mjs",
    "typecheck": "astro check",
    "check:policy": "node scripts/check-repository-policy.mjs",
    "check:normative-release": "node scripts/check-normative-release-source.mjs",
    "check:normative-metadata": "node scripts/check-normative-metadata.mjs",
    "check:normative-routes": "node scripts/check-normative-routes.mjs",
    "check:discovery": "node scripts/check-discovery-files.mjs",
    "check:normative-artifacts": "node scripts/check-normative-artifacts.mjs",
    "check:normative-specification": "node scripts/sync-normative-specification.mjs --check",
    "check:normative-references": "node scripts/check-normative-reference-pages.mjs",
    "check:learn": "node scripts/check-learn-pages.mjs",
    "check:runtime": "node scripts/check-runtime-pages.mjs",
    "check:sdk-matrix": "node scripts/check-sdk-runtime-matrix.mjs",
    "generate:sdk-inventories": "node scripts/generate-sdk-api-inventories.mjs",
    "check:sdk-inventories": "node scripts/check-sdk-api-inventories.mjs",
    "check:sdk-components": "node scripts/check-sdk-reference-components.mjs",
    "check:sdk-python": "node scripts/check-python-sdk-reference.mjs",
    "check:sdk-typescript-go": "node scripts/check-typescript-go-sdk-reference.mjs",
    "check:sdk-rust-java-cpp": "node scripts/check-rust-java-cpp-sdk-reference.mjs",
    "test:sdk-examples": "node scripts/test-verify-sdk-examples.mjs",
    "verify:sdk-examples": "node scripts/verify-sdk-examples.mjs",
    "test:published-site": "node --test scripts/test-verify-published-site.mjs",
    "verify:preview": "node scripts/verify-published-site.mjs --spawn-preview",
    "verify:live": "node scripts/verify-published-site.mjs",
    "test:local-docs": "node scripts/test-local-documentation-links.mjs",
    "check:local-docs": "node scripts/check-local-documentation-links.mjs",
    "check:generated-release": "node scripts/check-generated-release.mjs",
    "check:release-sources": "node scripts/check-normative-sources.mjs",
    "test:normative-locales": "node scripts/test-normative-locales.mjs",
    "test:locale-signatures": "node scripts/test-locale-clause-signatures.mjs",
    "generate:locale-signatures": "node scripts/generate-locale-clause-signatures.mjs",
    "check:locale-signatures": "node scripts/check-locale-clause-signatures.mjs",
    "check:normative-locales": "node scripts/check-normative-locales.mjs",
    "check:locales": "node scripts/check-locale-source-parity.mjs && node scripts/check-normative-locales.mjs",
    "check:terminology": "node scripts/check-locale-terminology.mjs",
    "check:built-site": "node scripts/check-built-site.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run check:policy && npm run check:normative-release && npm run check:normative-metadata && npm run check:normative-routes && npm run check:discovery && npm run check:normative-artifacts && npm run test:normative-specification && npm run check:normative-specification && npm run test:normative-clauses && npm run check:normative-clauses && npm run check:normative-references && npm run check:learn && npm run check:runtime && npm run check:sdk-matrix && npm run check:sdk-inventories && npm run check:sdk-components && npm run check:sdk-python && npm run check:sdk-typescript-go && npm run check:sdk-rust-java-cpp && npm run test:sdk-examples && npm run test:published-site && npm run test:local-docs && npm run check:local-docs && npm run test:normative-locales && npm run check:locales && npm run check:terminology && npm run test:locale-signatures && npm run check:locale-signatures && npm run assets:check && npm run format:check && npm run typecheck && npm run docs:build && npm run check:generated-release && npm run check:built-site",
    "test:normative-clauses": "node scripts/test-normative-clauses.mjs",
    "check:normative-clauses": "node scripts/check-normative-clauses.mjs"
  },
  "dependencies": {
    "@astrojs/sitemap": "3.7.3",
    "@astrojs/starlight": "0.41.3",
    "astro": "7.0.9"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.9",
    "js-yaml": "4.2.0",
    "prettier": "3.9.5",
    "prettier-plugin-astro": "0.14.1",
    "remark-gfm": "4.0.1",
    "remark-mdx": "3.1.1",
    "remark-parse": "11.0.0",
    "sharp": "0.35.3",
    "typescript": "6.0.3",
    "unified": "11.0.5"
  },
  "overrides": {
    "js-yaml@^4.0.0": "4.2.0"
  }
}
